<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Search Results for "<%= query %>"</title>
    <link rel="stylesheet" href="/css/style.css" />
  </head>
  <body>
    <!-- Header -->
    <%- include(isLoggedIn ? 'partials/loggedinHeader' : 'partials/header') %>

    <main class="search-results-layout">
      <section class="top-section">
        <!-- Sidebar -->
        <div class="sidebar-home">
          <!-- Categories -->
          <article class="categories-article">
            <h3>Categories</h3>
            <ul class="category-list">
              <li>
                <form action="/search" method="GET">
                  <input type="hidden" name="q" value="CPU" />
                  <button type="submit">Processors</button>
                </form>
              </li>
              <li>
                <form action="/search" method="GET">
                  <input type="hidden" name="q" value="GPU" />
                  <button type="submit">Graphics Cards</button>
                </form>
              </li>
              <li>
                <form action="/search" method="GET">
                  <input type="hidden" name="q" value="Memory" />
                  <button type="submit">RAM</button>
                </form>
              </li>
              <li>
                <form action="/search" method="GET">
                  <input type="hidden" name="q" value="Storage" />
                  <button type="submit">Storage</button>
                </form>
              </li>
              <li>
                <form action="/search" method="GET">
                  <input type="hidden" name="q" value="Motherboard" />
                  <button type="submit">Motherboards</button>
                </form>
              </li>
              <li>
                <form action="/search" method="GET">
                  <input type="hidden" name="q" value="PSU" />
                  <button type="submit">Power Supplies</button>
                </form>
              </li>
            </ul>
          </article>

          <!-- Brands -->
          <article class="brands-article">
            <h3>Brands</h3>
            <ul class="brand-list">
              <li>
                <form action="/search" method="GET">
                  <input type="hidden" name="q" value="MSI" />
                  <button type="submit">MSI</button>
                </form>
              </li>
              <li>
                <form action="/search" method="GET">
                  <input type="hidden" name="q" value="Asus" />
                  <button type="submit">Asus</button>
                </form>
              </li>
              <li>
                <form action="/search" method="GET">
                  <input type="hidden" name="q" value="AMD" />
                  <button type="submit">AMD</button>
                </form>
              </li>
              <li>
                <form action="/search" method="GET">
                  <input type="hidden" name="q" value="Intel" />
                  <button type="submit">Intel</button>
                </form>
              </li>
              <li>
                <form action="/search" method="GET">
                  <input type="hidden" name="q" value="Gigabyte" />
                  <button type="submit">Gigabyte</button>
                </form>
              </li>
              <li>
                <form action="/search" method="GET">
                  <input type="hidden" name="q" value="NZXT" />
                  <button type="submit">NZXT</button>
                </form>
              </li>
            </ul>
          </article>
        </div>

        <!-- Products List -->
        <div class="products-list-container">
          <h1 class="search-title">Search results for "<%= query %>"</h1>

          <% if (results.length === 0) { %>
            <p class="no-results">No products found.</p>
          <% } else { %>
            <div class="products-list">
              <% results.forEach(product => { %>
                <form
                  action="/product/<%= product._id %>"
                  method="GET"
                  class="product-form"
                >
                  <button type="submit" class="product-list-item">
                    <img
                      src="<%= product.image || '/assets/default.png' %>"
                      alt="<%= product.title || 'Product Image' %>"
                    />
                    <div class="product-list-info">
                      <h3><%= product.title %></h3>
                      <p>
                        <%= product.description && product.description.length > 80 
                          ? product.description.substring(0, 80) + '...' 
                          : (product.description || 'No description available') %>
                      </p>
                      <p>Category: <%= product.category %></p>
                    </div>
                    <div class="product-price-stock">
                      <p>₱<%= product.price ? product.price.toLocaleString() : 'N/A' %></p>
                      <p class="<%= product.instock ? 'in-stock' : 'out-of-stock' %>">
                        <%= product.instock ? 'In Stock' : 'Out of Stock' %>
                      </p>
                    </div>
                  </button>
                </form>
              <% }) %>
            </div>

            <!-- Pagination -->
            <% if (totalPages > 1) { %>
              <div class="pagination">
                <% if (page > 1) { %>
                  <a href="/search?q=<%= query %>&page=<%= page - 1 %>" class="page-btn">Previous</a>
                <% } %>

                <% for (let p = 1; p <= totalPages; p++) { %>
                  <a href="/search?q=<%= query %>&page=<%= p %>"
                    class="page-btn <%= p === page ? 'active' : '' %>"><%= p %></a>
                <% } %>

                <% if (page < totalPages) { %>
                  <a href="/search?q=<%= query %>&page=<%= page + 1 %>" class="page-btn">Next</a>
                <% } %>
              </div>
            <% } %>
          <% } %>
        </div>
      </section>
    </main>


    <!-- Login Modal -->
    <%- include('partials/loginModal') %>

    <!-- Footer -->
    <%- include('partials/footer') %>

    <!-- Scripts -->
    <script src="/js/product.js"></script>
    <script src="/js/auth.js"></script>
    <script src="/js/main.js"></script>
    <script src="/js/login.js"></script>
  </body>
</html>
