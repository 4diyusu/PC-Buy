<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>PC Buy - Cart</title>
    <link rel="stylesheet" href="/css/style.css" />
  </head>
  <body>
    <!-- Header -->
    <%- include(isLoggedIn ? 'partials/loggedinHeader' : 'partials/header') %>

    <main class="main-layout">
      <% if (cartItems.length === 0) { %>
        <section class="empty-cart">
          <p>Your cart is empty. <a href="/">Browse products</a></p>
        </section>
      <% } else { %>
        <section class="cart-items">
          <% cartItems.forEach(item => { %>
            <div class="cart-item">
              <img 
                class="product-img" 
                src="<%= item.product.image || '/assets/default.png' %>" 
                alt="<%= item.product.title %>" 
                width="80" />
              <div class="cart-info">
                <h4><%= item.product.title %></h4>
                <p>₱<%= item.product.price %></p>

                <div class="cart-actions">
                  <!-- Quantity Update -->
                  <form action="/cart/update/<%= item.product._id %>" method="POST" class="qty-form">
                    <button type="submit" name="action" value="decrease" class="btn-minus">−</button>
                    <input 
                      type="number" 
                      name="qty" 
                      id="qty-<%= item.product._id %>" 
                      value="<%= item.quantity %>" 
                      min="1" 
                      readonly />
                    <button type="submit" name="action" value="increase" class="btn-plus">+</button>
                  </form>

                  <!-- Remove Button -->
                  <form action="/cart/remove/<%= item.product._id %>" method="POST" class="remove-form">
                    <button type="submit" class="btn-remove">Remove</button>
                  </form>
                </div>
              </div>
            </div>
          <% }) %>
        </section>

        <hr />

        <section class="cart-summary">
          <h3>Total: ₱<%= total %></h3>
          <% if (isLoggedIn) { %>
            <form action="/checkout" method="GET">
              <input type="hidden" name="total" value="<%= total %>" />
              <button type="submit" class="btn btn-primary">Checkout</button>
            </form>
          <% } else { %>
            <p class="cart-login-warning">
              Please 
              <a href="#" onclick="document.getElementById('openLoginBtn').click(); return false;">
                Login
              </a> 
              to proceed to checkout.
            </p>
          <% } %>
        </section>
      <% } %>
    </main>

    <!-- Login Modal -->
    <%- include('partials/loginModal') %>

    <!-- Footer -->
    <%- include('partials/footer') %>

    <!-- Scripts -->
    <script src="/js/auth.js"></script>
    <script src="/js/main.js"></script>
    <script src="/js/login.js" defer></script>
    <script src="/js/cart.js" defer></script>
  </body>
</html>
