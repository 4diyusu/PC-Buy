<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Select Payment Method | PC Buy</title>
  <link rel="stylesheet" href="/css/style.css">
</head>
<body>

  <!-- Header -->
  <%- include(isLoggedIn ? 'partials/loggedinHeader' : 'partials/header', { isLoggedIn, username }) %>

  <!-- Payment Wrapper -->
  <div class="payment-wrapper">
    <div class="payment-box">
      <h1>Select Payment Method</h1>

      <form id="paymentForm" action="/payment" method="POST">
        <!-- Cart Summary -->
        <% if (cartItems && cartItems.length) { %>
          <div class="cart-summary">
            <h3>Order Summary</h3>
            <ul>
              <% cartItems.forEach(item => { %>
                <li>
                  <%= item.product.title %> x <%= item.quantity %> — ₱<%= item.subtotal %>
                </li>
              <% }) %>
            </ul>
            <p><strong>Total: ₱<%= total %></strong></p>
          </div>
        <% } %>

        <!-- Payment Method Dropdown -->
        <div class="form-group">
          <label for="paymentMethod">Choose Method</label>
          <select id="paymentMethod" name="paymentMethod" required>
            <option value="" disabled selected>Select an option</option>
            <option value="gcash">GCash</option>
            <option value="cod">Cash on Delivery (COD)</option>
            <option value="card">Credit / Debit Card</option>
          </select>
        </div>

        <!-- GCash Section -->
        <div id="gcashSection" class="payment-section hidden">
          <h3>GCash Payment Details</h3>
          <label for="gcashName">Account Name</label>
          <input type="text" id="gcashName" name="gcashName" placeholder="Full Name">
          <label for="gcashNumber">GCash Number</label>
          <input type="text" id="gcashNumber" name="gcashNumber" placeholder="09XXXXXXXXX">
        </div>

        <!-- COD Section -->
        <div id="codSection" class="payment-section hidden">
          <h3>Cash on Delivery</h3>
          <p>Your order will be processed for approval before delivery.</p>
        </div>

        <!-- Card Section -->
        <div id="cardSection" class="payment-section hidden">
          <h3>Card Payment Details</h3>
          <label for="cardNumber">Card Number</label>
          <input type="text" id="cardNumber" name="cardNumber" placeholder="1234 5678 9012 3456">
          <label for="cardName">Name on Card</label>
          <input type="text" id="cardName" name="cardName" placeholder="Full Name">
          <div class="card-info">
            <div>
              <label for="expiry">Expiry Date</label>
              <input type="text" id="expiry" name="expiry" placeholder="MM/YY">
            </div>
            <div>
              <label for="cvv">CVV</label>
              <input type="password" id="cvv" name="cvv" maxlength="3" placeholder="123">
            </div>
          </div>
          <label class="save-card">
            <input type="checkbox" name="saveCard"> Save card for future payments
          </label>
        </div>

        <!-- Buttons -->
        <div class="payment-actions">
          <button id="proceedBtn" type="submit" class="btn-primary" disabled>Proceed</button>
          <a href="/checkout" class="btn-secondary">Back to Checkout</a>
        </div>
      </form>
    </div>
  </div>

  <!-- Footer -->
  <%- include('partials/footer') %>

  <script src="/js/payment.js"></script>
  <script src="/js/main.js"></script>
</body>
</html>
