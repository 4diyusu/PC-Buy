<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>PC Buy - Home</title>
    <link rel="stylesheet" href="/css/style.css" />
  </head>
  <body>
    <!-- Header (Dynamic based on login state) -->
    <%- include(isLoggedIn ? 'partials/loggedinHeader' : 'partials/header') %>

    <main class="main-layout">
      <section class="top-section">
        <div class="sidebar-home">
          <!-- Categories -->
          <article class="categories-article">
            <h3>Categories</h3>
            <ul class="category-list">
              <li>
                <form action="/search" method="GET">
                  <input type="hidden" name="q" value="CPU" />
                  <button type="submit">Processors</button>
                </form>
              </li>
              <li>
                <form action="/search" method="GET">
                  <input type="hidden" name="q" value="GPU" />
                  <button type="submit">Graphics Cards</button>
                </form>
              </li>
              <li>
                <form action="/search" method="GET">
                  <input type="hidden" name="q" value="Memory" />
                  <button type="submit">RAM</button>
                </form>
              </li>
              <li>
                <form action="/search" method="GET">
                  <input type="hidden" name="q" value="Storage" />
                  <button type="submit">Storage</button>
                </form>
              </li>
              <li>
                <form action="/search" method="GET">
                  <input type="hidden" name="q" value="Motherboard" />
                  <button type="submit">Motherboards</button>
                </form>
              </li>
              <li>
                <form action="/search" method="GET">
                  <input type="hidden" name="q" value="PSU" />
                  <button type="submit">Power Supplies</button>
                </form>
              </li>
            </ul>
          </article>

          <!-- Brands -->
          <article class="brands-article">
            <h3>Brands</h3>
            <ul class="brand-list">
              <li>
                <form action="/search" method="GET">
                  <input type="hidden" name="q" value="MSI" />
                  <button type="submit">MSI</button>
                </form>
              </li>
              <li>
                <form action="/search" method="GET">
                  <input type="hidden" name="q" value="Asus" />
                  <button type="submit">Asus</button>
                </form>
              </li>
              <li>
                <form action="/search" method="GET">
                  <input type="hidden" name="q" value="AMD" />
                  <button type="submit">AMD</button>
                </form>
              </li>
              <li>
                <form action="/search" method="GET">
                  <input type="hidden" name="q" value="Intel" />
                  <button type="submit">Intel</button>
                </form>
              </li>
              <li>
                <form action="/search" method="GET">
                  <input type="hidden" name="q" value="Gigabyte" />
                  <button type="submit">Gigabyte</button>
                </form>
              </li>
              <li>
                <form action="/search" method="GET">
                  <input type="hidden" name="q" value="NZXT" />
                  <button type="submit">NZXT</button>
                </form>
              </li>
            </ul>
          </article>
        </div>

        <!-- Recommended Products -->
        <article class="products-article">
          <h2>Recommended Products</h2>
          <div class="product-grid">
            <% recommendedProducts.forEach(p => { %>
              <div class="product-card">
                <img 
                  src="<%= p.image || '/assets/default.png' %>" 
                  alt="<%= p.title %>" 
                  onclick="location.href='/product?id=<%= p._id %>'"
                  class="product-img"
                />
                <h4><%= p.title %></h4>
                <p class="product-desc"><%= p.description.length > 100 ? p.description.substring(0, 100) + '...' : p.description %></p>
                <button onclick="location.href='/product?id=<%= p._id %>'">
                  View Product
                </button>
              </div>
            <% }); %>
          </div>
        </article>
      </section>

      <!-- Brand Boxes -->
      <section class="brand-box-section">
        <h2>Shop by Brand</h2>
        <div class="brand-box-grid">
          <% ['MSI', 'Gigabyte', 'ASUS', 'Intel', 'AMD', 'NVIDIA'].forEach(function(brand) { %>
            <form action="/search" method="GET" style="display:inline-block;">
              <input type="hidden" name="q" value="<%= brand %>" />
              <button class="brand-box" type="submit"><%= brand %></button>
            </form>
          <% }); %>
        </div>
      </section>

      <!-- All Products -->
      <section class="all-products-section">
        <h2>All Products</h2>
        <div class="product-grid">
          <% allProducts.slice(0, 20).forEach(p => { %>
            <div class="product-card">
              <img 
                src="<%= p.image || '/assets/default.png' %>" 
                alt="<%= p.title %>" 
                onclick="location.href='/product?id=<%= p._id %>'"
                class="product-img"
              />
              <h4><%= p.title %></h4>
              <p class="product-desc"><%= p.description.length > 100 ? p.description.substring(0, 100) + '...' : p.description %></p>
              <button onclick="location.href='/product?id=<%= p._id %>'">
                View Product
              </button>
            </div>
          <% }); %>
        </div>
      </section>
    </main>

    <!-- Login Modal -->
    <%- include('partials/loginModal') %>

    <!-- Footer -->
    <%- include('partials/footer') %>

    <!-- Scripts -->
    <script src="/js/auth.js"></script>
    <script src="/js/main.js"></script>
    <script src="/js/login.js" defer></script>
  </body>
</html>
