<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Order Confirmed | PC Buy</title>
  <link rel="stylesheet" href="/style.css">
</head>
<body>

  <!-- Header -->
  <%- include('partials/header', { isLoggedIn, username }) %>

  <!-- Confirmation Section -->
  <section class="confirmed-order">
    <div class="order-container">
      <h1>✅ Order Placed!</h1>
      <p>Hi <%= username %>, your order has been successfully placed.</p>
      <p>Status: <strong>Waiting for approval</strong></p>

      <div class="order-actions">
        <a href="/" class="btn-primary">Back to Home</a>
        <a href="/cart" class="btn-secondary">Back to Cart</a>
      </div>
    </div>
  </section>

  <!-- Footer -->
  <%- include('partials/footer') %>

</body>
</html>
